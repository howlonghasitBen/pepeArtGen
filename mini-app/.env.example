# Private Keys (NEVER COMMIT ACTUAL KEYS)
PRIVATE_KEY=your_private_key_here

# Wallet Addresses
TREASURY_ADDRESS=0x_your_treasury_address
ROYALTY_RECEIVER=0x_your_royalty_receiver_address

# Network Configuration
NETWORK=base
# Options: 'base' for mainnet, 'baseSepolia' for testnet

# RPC Endpoints
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Or use Alchemy (recommended for production)
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# API Keys
BASESCAN_API_KEY=your_basescan_api_key
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key
API_KEY=your_google_ai_api_key

# IPFS Configuration
PINATA_JWT=your_pinata_jwt_token
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Supabase Configuration
# Get these from your Supabase project: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Note: Anon key is kept for legacy compatibility but not used with RLS enabled

# CRITICAL: Service role key is REQUIRED for all database operations
# This key bypasses Row Level Security (RLS) for secure server-side access
# All tables have RLS enabled - only service role can access them
# NEVER expose this key to the client or commit it to version control
# Get this from: https://app.supabase.com/project/_/settings/api (service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Contract Configuration
MAX_SUPPLY=10000
ROYALTY_BPS=500
USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Note: USDC on Base mainnet is 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# For Base Sepolia testnet, use: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# USDC is only used for generation payment (backend), NOT for minting

# Frontend Environment Variables (for Vite)
VITE_NFT_CONTRACT_ADDRESS=0x_your_deployed_waves_tcg_contract_address
VITE_USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VITE_TREASURY_ADDRESS=0x_your_treasury_address
VITE_NETWORK=base
# CRITICAL: Get a real WalletConnect Project ID for mobile wallet support
# Free at: https://cloud.walletconnect.com/
# Required for Coinbase Wallet/Base app and other mobile wallets
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
VITE_API_BASE_URL=http://localhost:3001
# For production: VITE_API_BASE_URL=https://your-backend-api.railway.app
# Note: Minting is FREE - users only pay gas fees (~$0.01 on Base)
# mintPrice is already set to 0 in the contract
