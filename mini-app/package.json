{
  "name": "pepe-card-generator",
  "version": "1.0.0",
  "description": "AI-powered trading card generator mini-app with USDC payments and NFT minting on Base L2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/api.mjs",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run dev:all",
    "server": "node server/api.mjs",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "test": "forge test -vv",
    "test:gas": "forge test --gas-report",
    "test:coverage": "forge coverage",
    "deploy:card:testnet": "forge script script/DeployPepeCardNFT.s.sol:DeployPepeCardNFT --rpc-url base_sepolia --broadcast --verify",
    "deploy:card:mainnet": "forge script script/DeployPepeCardNFT.s.sol:DeployPepeCardNFT --rpc-url base --broadcast --verify --slow",
    "deploy:full:testnet": "forge script script/Deploy.s.sol:DeployPepeArtGen --rpc-url base_sepolia --broadcast --verify",
    "deploy:full:mainnet": "forge script script/Deploy.s.sol:DeployPepeArtGen --rpc-url base --broadcast --verify --slow",
    "upload:ipfs": "node uploadToIPFS.js",
    "install:foundry": "forge install OpenZeppelin/openzeppelin-contracts"
  },
  "keywords": [
    "nft",
    "erc721",
    "base",
    "foundry",
    "solidity",
    "ipfs",
    "ai-art",
    "trading-cards",
    "react",
    "wagmi",
    "usdc"
  ],
  "author": "Ben (SURF Waves Collection)",
  "license": "GPL-3.0",
  "dependencies": {
    "@ai-sdk/google": "^1.2.22",
    "@farcaster/miniapp-sdk": "^0.2.1",
    "@google/genai": "^1.0.0",
    "@react-spring/web": "9.7.5",
    "@react-three/drei": "^9.92.7",
    "@react-three/fiber": "^8.15.19",
    "@reown/appkit": "1.5.0",
    "@reown/appkit-adapter-wagmi": "1.5.0",
    "@supabase/supabase-js": "^2.49.2",
    "@tanstack/react-query": "^5.62.0",
    "@use-gesture/react": "^10.3.1",
    "ai": "^4.3.19",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.13.4",
    "express": "^4.21.2",
    "node-vibrant": "^4.0.3",
    "ox": "0.6.7",
    "pinata": "^2.5.1",
    "puppeteer": "^24.31.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.158.0",
    "viem": "^2.21.53",
    "wagmi": "^2.12.33"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
