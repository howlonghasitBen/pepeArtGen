    "@use-gesture/react": "^10.3.1",
    "ai": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^11.13.5",
    "node-vibrant": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-spring": "^9.7.5",
    "viem": "^2.21.45",
    "wagmi": "^2.12.29"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
