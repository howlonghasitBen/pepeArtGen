{
  "name": "pepe-card-mini-app",
  "version": "1.0.0",
  "description": "Mobile-friendly card generator mini-app on Base",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/api.mjs",
