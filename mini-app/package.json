{
  "name": "pepeartgen-contracts",
  "version": "1.0.0",
  "description": "Production NFT minting contracts for PepeArtGen AI trading cards on Base L2",
  "type": "module",
  "scripts": {
    "test": "forge test -vv",
    "test:gas": "forge test --gas-report",
    "test:coverage": "forge coverage",
    "deploy:testnet": "forge script script/Deploy.s.sol:DeployPepeArtGen --rpc-url base_sepolia --broadcast --verify",
    "deploy:mainnet": "forge script script/Deploy.s.sol:DeployPepeArtGen --rpc-url base --broadcast --verify --slow",
    "upload:ipfs": "node uploadToIPFS.js",
    "install:foundry": "forge install OpenZeppelin/openzeppelin-contracts",
    "server": "node server/api.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "nft",
    "erc721",
    "base",
    "foundry",
    "solidity",
    "ipfs",
    "ai-art"
  ],
  "author": "Ben (SURF Waves Collection)",
  "license": "GPL-3.0",
  "dependencies": {
    "@ai-sdk/google": "^1.2.22",
    "@google/generative-ai": "^0.24.1",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "@supabase/supabase-js": "^2.49.2",
    "@tanstack/react-query": "^5.62.13",
    "@use-gesture/react": "^10.3.1",
    "ai": "^4.3.19",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "liquid-glass-react": "^1.1.1",
    "node-vibrant": "^4.0.3",
    "pinata": "^2.5.1",
    "puppeteer": "^24.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-spring": "^10.0.3",
    "viem": "^2.21.54",
    "wagmi": "^2.14.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
